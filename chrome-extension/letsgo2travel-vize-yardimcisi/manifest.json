{
  "manifest_version": 3,
  "name": "LetsGo2Travel Vize Yardımcısı",
  "version": "1.0.0",
  "description": "Açık iDATA sayfasındaki görünür randevu durumunu kullanıcının onayıyla LetsGo2Travel takip paneline iletir.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.letsgo2travel.com.tr/*",
    "https://letsgo2travel.com.tr/*",
    "https://de-tr-appointment.idata.com.tr/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "LetsGo2Travel Vize Yardımcısı",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://de-tr-appointment.idata.com.tr/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}

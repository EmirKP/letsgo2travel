{
  "name": "letsgo2travel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:copy": "npx cap copy",
    "mobile:prepare": "npm run mobile:prepare:ios",
    "mobile:prepare:ios": "npm run mobile:build && npx cap sync ios && npm run mobile:doctor -- --platform=ios",
    "mobile:prepare:android": "npm run mobile:build && npx cap sync android && npm run mobile:doctor -- --platform=android",
    "mobile:build": "npm --prefix mobile run build && node scripts/copy-mobile-build.mjs",
    "mobile:check": "npm --prefix mobile run lint && npm --prefix mobile run build && node scripts/copy-mobile-build.mjs && npx cap copy && npm run mobile:doctor",
    "mobile:check:ios": "npm --prefix mobile run lint && npm run mobile:build && npx cap sync ios && npm run mobile:doctor -- --platform=ios",
    "mobile:prepare:all": "npm run mobile:build && npx cap sync ios && npx cap sync android && npm run mobile:doctor",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "mobile:doctor": "node scripts/mobile-doctor.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:alerts": "node scripts/run-alert-tests.mjs",
    "test:app": "node scripts/run-app-tests.mjs",
    "test:integrity": "node tests/integrity/run.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",

    "@types/sanitize-html": "^2.16.0",
    "airports": "1.0.0",
    "airports-json": "1.0.0",
    "d3-geo": "3.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "i18n-iso-countries": "7.14.0",

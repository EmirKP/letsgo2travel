    "@google/genai": "^2.15.0",
    "@supabase/supabase-js": "^2.108.1",
    "canvas-confetti": "^1.9.4",
    "cobe": "^2.0.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.18.0",
    "next": "16.3.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-simple-maps": "4.0.0-beta.6",

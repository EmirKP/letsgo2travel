# LetsGo2Travel environment anahtar ADLARI (degerler asla repoya yazilmaz)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Genel
NEXT_PUBLIC_SITE_URL=
ANALYTICS_HASH_SALT=
CRON_SECRET=

# Cockpit flight lookup (server only; keep disabled until trial/production checks pass)
FLIGHT_LOOKUP_ENABLED=false
AERODATABOX_API_CHANNEL=rapidapi
AERODATABOX_API_KEY=
# trial is limited to the specified authenticated users and cannot save provider trips.
FLIGHT_LOOKUP_MODE=trial
FLIGHT_LOOKUP_TRIAL_USER_IDS=
# Counts requests, not provider units: a normal flight request uses 2 units.
FLIGHT_LOOKUP_MONTHLY_LIMIT=50
# Random server secret of at least 32 characters, required only for commercial saving.
FLIGHT_LOOKUP_RECEIPT_SECRET=

# E-posta (Resend)
RESEND_API_KEY=
RESEND_FROM=

# Fiyat alarmi fiyat kontrolu (Travelpayouts Data API)
TRAVELPAYOUTS_TOKEN=

# Dunya Etkinlik Radari
# Ana kaynak: Ticketmaster Discovery API
TICKETMASTER_API_KEY=
# Kuresel yedek: Ticketmaster kapsam disiysa veya sonuc bulamazsa PredictHQ
# (sunucu tarafi access token; istemciye VITE_/NEXT_PUBLIC_ ile ACILMAZ)
PREDICTHQ_ACCESS_TOKEN=

# Push bildirimleri — iOS (APNs, token tabanli .p8; degerler yalniz env'de)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=tr.com.letsgo2travel.app
APNS_ENVIRONMENT=sandbox

# Push bildirimleri — Android (FCM HTTP v1 service-account JSON icerigi)
FCM_SERVICE_ACCOUNT_JSON=

# AI (opsiyonel)
GEMINI_API_KEY=
OPENAI_API_KEY=

# KVKK / hukuki metinler
NEXT_PUBLIC_DATA_CONTROLLER_NAME=
NEXT_PUBLIC_DATA_CONTROLLER_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Affiliate (onayli moduller)
NEXT_PUBLIC_BOOKING_AFFILIATE_URL=
NEXT_PUBLIC_AIRALO_AFFILIATE_URL=
NEXT_PUBLIC_GYG_AFFILIATE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Visa worker (VDS)
VISA_WORKER_SECRET=

# Haritali gunluk plan: sadece SUNUCUDA kullanilir, VITE_/NEXT_PUBLIC_ yapmayin.
# Kesintisiz mekan kesfi icin ticari kullanima uygun veya kendi Overpass /api/interpreter ucunuz.
TRAVEL_OVERPASS_URL=
# Gercek yuruyus geometrisi/suresi: https://openrouteservice.org/
TRAVEL_ORS_API_KEY=
# Kendi ORS kurulumunuz varsa tam /v2/directions/foot-walking/geojson ucu.
TRAVEL_ORS_URL=
# Ticari kullanim izni olan Nominatim-uyumlu adres arama servisi /search ucu.
# Kamusal nominatim.openstreetmap.org varsayilmaz. Bosken kayitli sehir secimi devam eder.
TRAVEL_GEOCODER_URL=

# Public, domain-restricted Apple MapKit JS token; never a .p8 or Server API key.
# iOS uses the native MapKit bridge and does not need this browser token.
VITE_APPLE_MAPS_TOKEN=

# Renewable MapKit JS authorization and real server-side Apple walking directions.
# These four values are SERVER ONLY; never prefix them with VITE_ or NEXT_PUBLIC_.
# Use a dedicated Apple Developer Maps key, not an APNs or Sign in with Apple key.
# Server walking uses a separate server_api token; neither it nor the private key reaches clients.
# Apple is primary when these credentials exist. Auth/quota errors never fall through to ORS.
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
# PEM content; escaped \n line breaks are supported. Keep the real value in .env.local.
APPLE_MAPS_PRIVATE_KEY=
# Exact origins including scheme and port, separated by commas; no wildcard.
# Local development example: http://127.0.0.1:5173,http://localhost:5173
# Production example: https://www.letsgo2travel.com.tr
# HTTP loopback origins are accepted only outside production.
APPLE_MAPS_ALLOWED_ORIGINS=

# AI itinerary uses the existing server-only GEMINI_API_KEY and GEMINI_MODEL.
# Optional journey-specific model override; no API keys belong in the mobile client.
# Live-verified journey model: gemini-2.5-flash (2026-10-14).
# Requires migrations 20261014150000_journey_plan_quota.sql and
# 20261014170000_journey_plan_reservations.sql, plus the existing
# SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_SECRET_KEY) on the main authenticated API.
GEMINI_JOURNEY_MODEL=

# Development-only Vite proxy for exactly /api/maps/token and the four
# /api/travel-assistant/{journey-route,discover,journey-search,journey-plan} endpoints.
# Existing tools such as places/emergency/rates and account API hosts stay unchanged.
# Set in .env.development.local to http://127.0.0.1:3000 and run the local Next server.
# Accepts only a canonical HTTP loopback origin. Never included in a release client.
L2T_MAPS_DEV_API_URL=

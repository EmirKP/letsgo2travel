# LetsGo2Travel environment anahtar ADLARI (degerler asla repoya yazilmaz)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Genel
NEXT_PUBLIC_SITE_URL=
ANALYTICS_HASH_SALT=
CRON_SECRET=

# E-posta (Resend)
RESEND_API_KEY=
RESEND_FROM=

# Fiyat alarmi fiyat kontrolu (Travelpayouts Data API)
TRAVELPAYOUTS_TOKEN=

# Push bildirimleri — iOS (APNs, token tabanli .p8; degerler yalniz env'de)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=tr.com.letsgo2travel.app
APNS_ENVIRONMENT=sandbox

# Push bildirimleri — Android (FCM HTTP v1 service-account JSON icerigi)
FCM_SERVICE_ACCOUNT_JSON=

# AI (opsiyonel)
GEMINI_API_KEY=
OPENAI_API_KEY=

# KVKK / hukuki metinler
NEXT_PUBLIC_DATA_CONTROLLER_NAME=
NEXT_PUBLIC_DATA_CONTROLLER_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Affiliate (onayli moduller)
NEXT_PUBLIC_BOOKING_AFFILIATE_URL=
NEXT_PUBLIC_AIRALO_AFFILIATE_URL=
NEXT_PUBLIC_GYG_AFFILIATE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Visa worker (VDS)
VISA_WORKER_SECRET=
